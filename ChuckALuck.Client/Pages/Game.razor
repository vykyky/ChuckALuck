@page "/game/{GameId}"
@inject GameClientService GameService
@using ChuckALuck.Shared
@using ChuckALuck.Client.Services
@inject NavigationManager Navigation
@implements IDisposable

<div class="game-page-container">
    <h2>@GameId</h2>

    <div class="game-info">
        <p>Игрок: <strong>@_playerId</strong></p>
        <p>Игроков в комнате: <strong>@(_state?.PlayerCount ?? 0)</strong></p>
        <p class="last-p">Ваши очки: <strong class="score" @key="_totalScore">@_totalScore</strong></p>
    </div>

    <div class="bet-block">
        <label>Число (1–6):</label>
        <input type="number" min="1" max="6" @bind="_number" />

        <label>Ставка:</label>
        <input type="number" @bind="_amount" />

        <button class="game-button make-bet-button" @onclick="MakeBet">Сделать ставку</button>
        @if (_betPlaced)
        {
            <span style="color: green; font-size: 1.5rem; margin-left: 0.5rem;">✔</span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert-message">@_errorMessage</div>
    }

    <button class="game-button roll-button" @onclick="Roll"> Бросить кости 🎲🎲🎲</button>

    @if (_state?.Dice != null && _state.Dice.Length > 0)
    {
        <GameBoard Dice="_state.Dice"
                   Results="_state.Results"
                   @key="_diceKey" />
    }


</div>


@code {
    [Parameter] public string GameId { get; set; } = null!;

    private string _playerId = Guid.NewGuid().ToString()[..8];
    private int _number = 1;
    private int _amount = 10;
    private string? _errorMessage;
    private GameStateDto? _state;
    private bool _betPlaced = false;
    private int _totalScore = 0;
    private int _diceKey = 0;
    private bool _waitingForDiceAnimation = false;


    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;

        GameService.GameStateChanged += async state =>
        {
            bool diceChanged =
            _state?.Dice == null ||
            !state.Dice.SequenceEqual(_state.Dice);

            _state = state;
            if (diceChanged && state.Dice is { Length: > 0 })
            {
                _diceKey++; 
                
            }
            var player = _state.Results?.FirstOrDefault(r => r.PlayerId == _playerId);
            if (player != null)
                _totalScore = player.TotalScore;
            if (_state.State == RoundState.Finished)
                _betPlaced = false;
            InvokeAsync(StateHasChanged);
        };

        GameService.ErrorOccurred += async message =>
        {
            await ShowAlert(message);
        };

        await GameService.ConnectAsync();
        await GameService.JoinGame(GameId, _playerId);
    }

    private async Task ShowAlert(string message)
    {
        _errorMessage = message;
        StateHasChanged();
        await Task.Delay(3000); 
        _errorMessage = null;
        StateHasChanged();
    }

    private async Task MakeBet()
    {
        if (_number < 1 || _number > 6)
        {
            await ShowAlert("Число должно быть от 1 до 6!");
            return;
        }

        await GameService.PlaceBet(GameId, new BetDto
        {
            PlayerId = _playerId,
            Number = _number,
            Amount = _amount
        });
        _betPlaced = true;
    }

    private async Task Roll()
    {
        
        await GameService.Roll(GameId);
        _betPlaced = false;
    }

    private async Task LeaveGame()
    {
        await GameService.LeaveGame(GameId, _playerId);
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!e.Location.EndsWith($"/game/{GameId}"))
        {
            await LeaveGame();
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
